# Comma-separated list of origins the backend's CORS middleware allows.
# Read by backend/app/main.py; falls back to the local-dev defaults below
# if unset, so leaving this unset keeps `docker compose up` working exactly
# as before. Override per-environment once a real staging/prod origin exists.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Once frontend/ exists and is wired into docker-compose.yml (see the
# commented-out frontend service there), it will need its own build-arg,
# same pattern as project #1's VITE_API_BASE_URL:
# VITE_API_BASE_URL=http://localhost:8000
